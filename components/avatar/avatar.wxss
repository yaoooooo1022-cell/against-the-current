.avatar {
  position: relative;
  border-radius: 50%;
  padding: 4rpx;              /* 外圈留白，形成「鎏金描边」效果 */
  border: 2rpx solid #b08d57;
  box-sizing: border-box;
}

.avatar--s { width: 92rpx;  height: 92rpx; }
.avatar--m { width: 132rpx; height: 132rpx; }
.avatar--l { width: 220rpx; height: 220rpx; }

.avatar__img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
}

.avatar__seal {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-width: 2rpx;
  border-style: solid;
  /* 内圈双层描边，模拟印章质感 */
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
}

.avatar__ch {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-weight: 600;
  line-height: 1;
}

.avatar--s .avatar__ch { font-size: 40rpx; }
.avatar--m .avatar__ch { font-size: 58rpx; }
.avatar--l .avatar__ch { font-size: 96rpx; }

.avatar__badge {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  border: 2rpx solid #fffdf8;
  box-sizing: border-box;
}
