/* ============================================================
   角色详情页
   ============================================================ */

/* ---------------------------- 头部 ---------------------------- */

.hero {
  position: relative;
  padding: 48rpx 32rpx 34rpx;
  text-align: center;
  border-bottom: 1rpx solid var(--line);
}

.hero__seal {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid;
  border-radius: 8rpx;
  opacity: 0.8;
}

.hero__avatar {
  display: inline-block;
}

.hero__name {
  margin-top: 26rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
  line-height: 1.2;
}

.hero__alias {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--ink-3);
}

.hero__actor {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: var(--gold);
  letter-spacing: 2rpx;
}

.hero__tags {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

/* ---------------------------- 时期版本提示 ---------------------------- */

.variant {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--gold-soft);
  border-radius: var(--radius-m);
}
.variant__t {
  flex: 1;
  font-size: 24rpx;
  color: #7a6033;
}
.variant__go {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
}

/* ---------------------------- 键值行 ---------------------------- */

.kv {
  display: flex;
  align-items: flex-start;
}
.kv__k {
  flex: none;
  width: 90rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  padding-top: 4rpx;
}
.kv__v {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink);
}

/* ---------------------------- 角色介绍 ---------------------------- */

.intro {
  font-size: 28rpx;
  line-height: 1.95;
  color: #3f3a33;
  text-align: justify;
  text-indent: 2em;
  white-space: pre-line;
}

/* ---------------------------- 演员 ---------------------------- */

.actor {
  display: flex;
  align-items: center;
}
.actor__av {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx;
  border: 2rpx solid var(--gold);
  box-sizing: border-box;
  line-height: 1.15;
}
.actor__main {
  margin-left: 24rpx;
}
.actor__name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.actor__role {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.actor__works {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed var(--line);
}
.actor__works-t {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 14rpx;
}
.actor__works-list {
  display: flex;
  flex-wrap: wrap;
}

/* ---------------------------- 人物关系 ---------------------------- */

.rel {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2ece0;
}
.rel:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.rel__main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.rel__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.rel__actor {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.rel__label {
  flex: none;
  font-size: 21rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid;
  border-radius: 30rpx;
  opacity: 0.9;
  max-width: 260rpx;
  text-align: center;
}
.rel__arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
  color: #d8cdb6;
}

/* ---------------------------- 历史参考人物 ---------------------------- */

.hist {
  display: flex;
  align-items: center;
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #3b3a36 0%, #565044 100%);
  border-radius: var(--radius-m);
  box-shadow: 0 6rpx 20rpx rgba(59, 58, 54, 0.18);
}
.hist__seal {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(214, 196, 154, 0.5);
  color: #e8d9b5;
  font-size: 24rpx;
  line-height: 1.15;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 8rpx;
  box-sizing: border-box;
}
.hist__main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.hist__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #f4ead2;
  letter-spacing: 3rpx;
}
.hist__dyn {
  font-size: 20rpx;
  color: #cbb98d;
  border: 1rpx solid rgba(203, 185, 141, 0.55);
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  letter-spacing: 2rpx;
  vertical-align: middle;
}
.hist__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bdb49c;
}
.hist__sum {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #a9a08a;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.hist__arrow {
  margin-left: 14rpx;
  font-size: 40rpx;
  color: rgba(244, 234, 210, 0.55);
}

/* ---------------------------- 页脚 ---------------------------- */

.footer {
  padding: 0 32rpx;
  text-align: center;
}
.footer__c {
  display: block;
  font-size: 20rpx;
  line-height: 1.8;
  color: #b8b0a2;
}

.back {
  display: inline-block;
  margin-top: 28rpx;
  padding: 16rpx 52rpx;
  font-size: 26rpx;
  color: var(--gold);
  border: 1rpx solid var(--gold);
  border-radius: 60rpx;
}
