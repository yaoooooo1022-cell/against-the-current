/* ============================================================
   角色图谱主页
   ============================================================ */

/* ---------------------------- Banner（紧凑横向布局 · 整块可点） ----------------------------
   设计约束：Banner + 搜索 + Tab 合计不超过首屏高度的 1/3，
   把主要纵向空间让给族谱区。因此 Banner 改为左文右入口的单行式排布；
   去掉右侧朱印后腾出的横向空间用于放回 tagline，纵向高度基本不变
   （改前约 200rpx，改后约 212rpx）。 */

.banner {
  display: flex;
  align-items: center;
  margin: 16rpx 20rpx 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-l);
  background: linear-gradient(150deg, #fffdf8 0%, #f6efdf 62%, #efe5cf 100%);
  border: 1rpx solid #e2d3b4;
  box-shadow: 0 4rpx 18rpx rgba(140, 43, 43, 0.06);
  overflow: hidden;
}
/* 点击反馈（配合 hover-class） */
.banner--hover {
  background: linear-gradient(150deg, #faf5ea 0%, #f0e7d3 62%, #e9dcc2 100%);
}

.banner__main {
  flex: 1;
  min-width: 0;
}

.banner__titlerow {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.banner__title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  color: #2b2b2b;
  line-height: 1.12;
}

.banner__sub {
  margin-left: 14rpx;
  font-size: 23rpx;
  letter-spacing: 2rpx;
  color: var(--gold);
}

/* tagline：一句剧集slogan，行内引号包裹，最多两行 */
.banner__tagline {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: #7a6b52;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.banner__q {
  color: rgba(176, 141, 87, 0.62);
}

.banner__meta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--ink-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.banner__meta .dot {
  margin: 0 8rpx;
  color: var(--gold);
}

/* 统计改为单行内联，不再占独立一行的大数字 */
.banner__stats {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #ded0b4;
  font-size: 20rpx;
  color: var(--ink-3);
}
.banner__stat {
  white-space: nowrap;
}
.banner__stat .stat__n {
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 26rpx;
  font-weight: 700;
  color: #9c3d3d;
  margin-right: 4rpx;
}
.banner__stat__dot {
  margin: 0 12rpx;
  color: #d8cdb6;
}

/* 右侧「剧情介绍」入口（替代原朱印，不占额外高度） */
.banner__more {
  flex: none;
  margin-left: 16rpx;
  padding: 12rpx 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(156, 61, 61, 0.42);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
}
.banner__more-t {
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 2rpx;
  color: #9c3d3d;
}
.banner__more-a {
  margin-top: 2rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #9c3d3d;
  opacity: 0.7;
}

/* ---------------------------- 搜索 ---------------------------- */

.search {
  display: flex;
  align-items: center;
  margin: 0 20rpx 14rpx;
  height: 68rpx;
  padding: 0 22rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 68rpx;
}
.search__icon {
  font-size: 34rpx;
  color: var(--gold);
  margin-right: 14rpx;
}
.search__input {
  flex: 1;
  font-size: 27rpx;
  color: var(--ink);
}
.search__ph {
  color: #b8b0a2;
  font-size: 25rpx;
}
.search__clear {
  padding: 0 6rpx;
  font-size: 28rpx;
  color: #b8b0a2;
}

/* ---------------------------- 搜索结果 ---------------------------- */

.results {
  margin: 0 20rpx;
}
.results__head {
  padding: 4rpx 8rpx 18rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.results__head .hl {
  color: #9c3d3d;
  font-weight: 700;
}

/* 通用行走行（搜索结果 / 全阵容复用） */
.rrow {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-m);
}
.rrow__main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.rrow__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rrow__alias {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
}
.rrow__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rrow__arrow {
  font-size: 40rpx;
  opacity: 0.55;
  margin-left: 10rpx;
}
/* 家族徽记：从行尾移到副标题行内，把行尾让给爱心按钮 */
.rrow__fam {
  display: inline-block;
  margin-right: 8rpx;
  font-size: 19rpx;
  line-height: 1.5;
  padding: 1rpx 10rpx;
  border: 1rpx solid;
  border-radius: 30rpx;
  opacity: 0.9;
}
.rrow .like {
  margin-left: 16rpx;
}

/* ---------------------------- Tab ---------------------------- */

.tabs {
  display: flex;
  align-items: center;
  margin: 0 20rpx 16rpx;
  padding: 6rpx;
  background: #efe9dc;
  border-radius: var(--radius-m);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
  border-radius: 12rpx;
  transition: all 0.18s;
}
.tab--on {
  background: #fffdf8;
  box-shadow: 0 2rpx 10rpx rgba(43, 43, 43, 0.08);
}
.tab__t {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 3rpx;
}
.tab--on .tab__t {
  color: #8c2b2b;
}

/* ---------------------------- 支持榜开关（单按钮） ---------------------------- */

.sortsw {
  flex: none;
  padding: 8rpx 18rpx;
  font-size: 21rpx;
  line-height: 1.2;
  color: var(--ink-2);
  background: #e3dac6;
  border-radius: 30rpx;
  transition: all 0.18s;
}
.sortsw--on {
  background: #8c2b2b;
  color: #fffdf8;
  font-weight: 600;
}

/* 支持榜口径说明 */
.sortnote {
  display: flex;
  align-items: baseline;
  margin: -6rpx 20rpx 14rpx;
  padding: 12rpx 18rpx;
  background: rgba(176, 141, 87, 0.1);
  border-left: 5rpx solid var(--gold);
  border-radius: 8rpx;
}
.sortnote__t {
  flex: none;
  margin-right: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #8a6a33;
  letter-spacing: 1rpx;
}
.sortnote__c {
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

/* ---------------------------- 爱心支持按钮 ---------------------------- */

.like {
  flex: none;
  display: flex;
  align-items: baseline;
  padding: 5rpx 14rpx;
  border: 1rpx solid;
  border-radius: 30rpx;
  opacity: 0.72;
  transition: all 0.16s;
}
.like--hover {
  opacity: 1;
  transform: scale(0.94);
}
.like--on {
  opacity: 1;
  /* 实心底色由模板按家族主色内联给出（避免依赖 currentColor 的表现差异） */
}
.like--on .like__i,
.like--on .like__n {
  color: #fffdf8;
}
.like__i {
  font-size: 21rpx;
  line-height: 1;
}
.like__n {
  margin-left: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* ---------------------------- 家族筛选 chips ---------------------------- */

.chips {
  display: flex;
  white-space: nowrap;
  padding: 0 20rpx 6rpx;
}
/* 隐藏横向滚动条（iOS 上默认是有的，露出来会压掉一行视觉空间） */
.chips::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
  display: none;
}
/* 高度固定 + 圆角 = 半高，这样不论 1 字还是 4 字都是标准胶囊；
   min-width 保证单字 chip 不会缩成一颗「小圆点」。 */
.chip {
  flex: none;
  margin-right: 12rpx;
  height: 56rpx;
  min-width: 88rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  color: var(--ink-2);
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  transition: all 0.15s;
}
.chip--on {
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(140, 43, 43, 0.18);
}
/* 按下反馈：手指按上去立刻有变化，避免「点了没反应」的错觉 */
.chip--tap {
  opacity: 0.6;
  transform: scale(0.96);
}

/* ---------------------------- 族谱 ---------------------------- */

.tree {
  padding: 8rpx 0 0;
}

.famcard {
  margin: 0 20rpx 20rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-l);
  overflow: hidden;
  box-shadow: 0 3rpx 16rpx rgba(43, 43, 43, 0.04);
}

.famcard__head {
  position: relative;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-left: 8rpx solid #9c3d3d;
}
.famcard__id {
  flex: 1;
  min-width: 0;
}
.famcard__name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
}
.famcard__tag {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-2);
}
/* 右侧竖排：格言徽记 + 爱心支持 */
.famcard__side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}
.famcard__motto {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  padding: 5rpx 14rpx;
  border: 1rpx solid;
  border-radius: 30rpx;
  opacity: 0.85;
  white-space: nowrap;
}
.famcard__side .like {
  margin-top: 10rpx;
}

.famcard__body {
  padding: 8rpx 10rpx 2rpx;
}

/* 辈分区块 */
.gen {
  padding: 14rpx 10rpx 4rpx;
}

.gen__label {
  display: flex;
  align-items: center;
  margin: 0 8rpx 16rpx;
}
.gen__line {
  width: 4rpx;
  height: 24rpx;
  border-radius: 2rpx;
  margin-right: 12rpx;
}
.gen__txt {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

/* 房（大房/二房）：每一房单独一行，夫妻妾排在一起 */
.branch {
  margin-bottom: 8rpx;
}
.branch__name {
  display: block;
  margin: 0 8rpx 4rpx;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

/* 辈分行 + 横向族谱连线 */
.gen__row {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding-top: 22rpx;
}
.gen__row::before {
  content: '';
  position: absolute;
  top: 0;
  left: 8%;
  right: 8%;
  height: 2rpx;
  background: linear-gradient(
    to right,
    rgba(176, 141, 87, 0) 0%,
    rgba(176, 141, 87, 0.55) 12%,
    rgba(176, 141, 87, 0.55) 88%,
    rgba(176, 141, 87, 0) 100%
  );
}

/* 仆从段（不进辈分层，按角色级别分组） */
.servants {
  margin-top: 20rpx;
  padding: 14rpx 10rpx 4rpx;
  border-top: 1rpx dashed #d9cdb4;
}
.servants__label {
  display: flex;
  align-items: center;
  margin: 0 8rpx 16rpx;
}
.sgroup {
  margin-bottom: 8rpx;
}
.sgroup__name {
  display: block;
  margin: 0 8rpx 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* 角色节点 */
.member {
  position: relative;
  width: 160rpx;
  margin: 0 4rpx 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 节点到横线的竖向支线 */
.member::before {
  content: '';
  position: absolute;
  top: -22rpx;
  left: 50%;
  width: 2rpx;
  height: 22rpx;
  background: rgba(176, 141, 87, 0.45);
}

.member__name {
  margin-top: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  line-height: 1.25;
}
.member__actor {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
}
.member__lead {
  margin-top: 6rpx;
  font-size: 17rpx;
  line-height: 1;
  padding: 4rpx 10rpx;
  color: #fff;
  background: #b08d57;
  border-radius: 20rpx;
}

/* ---------------------------- 全阵容 ---------------------------- */

.roster {
  margin: 0 20rpx;
}

/* ---------------------------- 左右滑动切 Tab ---------------------------- */

.swipetip {
  padding: 4rpx 0 8rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #c2baaa;
}

/* ---------------------------- 说明 / 页脚 ---------------------------- */

.note {
  margin: 4rpx 20rpx 0;
  padding: 22rpx 24rpx;
  background: #f7f3ea;
  border: 1rpx dashed #ded0b4;
  border-radius: var(--radius-m);
}
.note__t {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold);
  margin-bottom: 8rpx;
}
.note__c {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.footer {
  padding: 0 32rpx 20rpx;
  text-align: center;
}
.footer__c {
  display: block;
  font-size: 20rpx;
  line-height: 1.8;
  color: #b8b0a2;
}

/* ============================================================
   分享卡片弹层（点爱心支持成功后弹出）
   背景为 AI 生成的中式美学卡片（参考剧集主 KV 风格）
   文案模板统一，差异仅在「吾为 XX 执灯」
   ============================================================ */

.sharemask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  /* iOS Home 指示条让位，避免底部按钮被指示条压住 */
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(43, 43, 43, 0.55);
}

/* 宽高由 graph.js 按屏幕实测给出（5:7.5 = 背景图 750×1125），
   不同机型都不会出屏，也不会像写死 760rpx 那样在小屏上挤成一团 */
.sharecard {
  position: relative;
  max-width: 620rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--card);
  box-shadow: 0 20rpx 60rpx rgba(43, 43, 43, 0.4);
  animation: sharePop 0.24s cubic-bezier(0.2, 0.9, 0.3, 1);
}

@keyframes sharePop {
  from { opacity: 0; transform: translateY(28rpx) scale(0.96); }
  to   { opacity: 1; transform: none; }
}

.sharecard__bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.sharecard__body {
  position: relative;
  flex: 1;
  min-height: 0;
  padding: 56rpx 44rpx 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sharecard__brand {
  position: absolute;
  top: 36rpx;
  left: 0;
  right: 0;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #b08d57;
  opacity: 0.85;
}

.sharecard__lead {
  font-size: 34rpx;
  letter-spacing: 8rpx;
  color: #5a5348;
  line-height: 1.3;
}

.sharecard__name {
  margin: 14rpx 0;
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #8c2b2b;
  line-height: 1.15;
  max-width: 100%;
  word-break: break-all;
}

.sharecard__sub {
  margin-top: 26rpx;
  padding: 0 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #6b6255;
  max-width: 88%;
}

.sharecard__count {
  margin-top: 36rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #8a6a33;
}
.sharecard__heart {
  color: #8c2b2b;
  margin-right: 4rpx;
}

.sharecard__foot {
  position: relative;
  flex: none;
  display: flex;
  gap: 20rpx;
  padding: 0 44rpx 28rpx;
}

/* 分享页底部广告位 */
/* 右上角关闭（iOS 上遮罩顶部可能被灵动岛区域吃掉，给一个明确出口） */
.sharecard__x {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 3;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  color: #6b6255;
  background: rgba(255, 253, 248, 0.9);
  border: 1rpx solid rgba(217, 205, 180, 0.9);
  border-radius: 50%;
}
.sharecard__x:active {
  opacity: 0.6;
}

.sharecard__btn {
  flex: 1;
  margin: 0;
  padding: 22rpx 0;
  font-size: 27rpx;
  letter-spacing: 3rpx;
  border-radius: 44rpx;
  line-height: 1.3;
  text-align: center;
}
.sharecard__btn--main {
  background: #8c2b2b;
  color: #fffdf8;
  font-weight: 600;
}
.sharecard__btn--main::after {
  border: none;
}
.sharecard__btn--ghost {
  background: rgba(255, 253, 248, 0.7);
  color: #6b6255;
  border: 1rpx solid #d9cdb4;
}
.sharecard__btn--ghost::after {
  border: none;
}
